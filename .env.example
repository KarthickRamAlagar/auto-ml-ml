# --- core ---
APP_ENV=development              # set to "production" on Hugging Face Spaces
AUTH_MODE=dev                    # "dev": Bearer dev:<email> (refused in production) | "gateway": behind the Cloudflare Worker (production)
FRONTEND_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
ADMIN_EMAILS=you@example.com     # comma-separated; admins also get free unlimited access
STORE_BACKEND=memory             # "remote" in production (the backend Worker's D1 + R2); "memory" is for tests only

# --- Cloudflare gateway (AUTH_MODE=gateway, STORE_BACKEND=remote) ---
# Generate the two secrets:  node ../scripts/gen-secrets.mjs   (64 hex characters each; they must equal the backend's)
GATEWAY_SECRET=                  # 32+ chars; same value as the Worker secret GATEWAY_SECRET
STORE_URL=                       # the BACKEND Worker's public URL, e.g. https://auto-ml-api.<you>.workers.dev
STORE_SECRET=                    # 32+ chars; same value as the Worker secret STORE_SECRET

# --- payments (static UPI QR) ---
UPI_ID=yourname@bank
UPI_PAYEE_NAME=Auto ML
ADMIN_NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=
MAIL_FROM=Auto ML <onboarding@resend.dev>

# --- datasets ---
# Kaggle search/download. Easiest: create a token at kaggle.com/settings -> API -> "Generate New Token".
KAGGLE_API_TOKEN=
# Legacy alternative (kaggle.json): username + key
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- YouTube lectures (Lectures tab) ---
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key. Free quota is plenty (results are cached 7 days).
YOUTUBE_API_KEY=
# Several keys are allowed: YOUTUBE_API_KEYS=key1,key2 (no spaces). A refused or over-quota key falls through to the next.

# --- LLM narration (optional; rules-based fallback works without) ---
# Simplest: set one or more provider keys. For each provider the server asks its /models endpoint and picks the most
# capable model available to your key (see Admin -> AI & integrations). Separate several keys with commas.
# Providers in use: Groq, Gemini, Mistral, OpenRouter. Use the plural name for several keys (no spaces, up to 5):
GROQ_API_KEYS=
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
OPENROUTER_API_KEYS=
# The single-key names also work: GROQ_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY, OPENROUTER_API_KEY.
# If one key fails (rate limit, bad key, outage) the next key is used automatically; Admin -> AI & integrations -> Test shows each key.
# Leave LLM_GROUPS empty. It is an advanced override that replaces the provider keys above.
# JSON list of groups; each group = {"group": "A", "models": [primary, backup1..backup4]} and each model is
# {"base_url": "https://api.groq.com/openai/v1", "model": "llama-3.1-8b-instant", "api_key_env": "GROQ_KEY_1"}.
# The keys themselves live in separate env vars (GROQ_KEY_1, ...) so they never appear in the JSON.
LLM_GROUPS=

# --- limits ---
MAX_UPLOAD_MB=25
MAX_TRAIN_ROWS=100000
MAX_JOB_SECONDS=600
RETENTION_DAYS=15                # saved results/chats are deleted this many days after the last update (datasets are never stored)
MIN_DATASET_ROWS=50000           # Kaggle / Hugging Face / UCI / recommended datasets must have at least this many rows...
MIN_DATASET_COLS=30              # ...and this many columns
MAX_EXTERNAL_MB=200              # largest file downloaded from an external source
REMIND_AFTER_SECONDS=420         # 7 minutes before the user can nudge the admin about a payment
DATASET_TTL_SECONDS=1800
JOB_TTL_SECONDS=3600
HF_TOKEN=                       # optional: huggingface.co/settings/tokens (read access); raises rate limits for the Hugging Face tab
