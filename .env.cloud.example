# Secrets for the ML service on Cloudflare. Copy to .env.cloud (git-ignored), fill in, then:
#   cd ml-service/cloudflare && npm run secrets
# Only set what you use. Plural *_KEYS take several keys separated by commas, no spaces.
GATEWAY_SECRET=
STORE_SECRET=
STORE_URL=https://auto-ml-api.YOUR-SUBDOMAIN.workers.dev
ADMIN_EMAILS=you@example.com
FRONTEND_ORIGINS=https://auto-ml-web.YOUR-SUBDOMAIN.workers.dev
PUBLIC_APP_URL=https://auto-ml-web.YOUR-SUBDOMAIN.workers.dev

UPI_ID=
UPI_PAYEE_NAME=Auto ML
ADMIN_NOTIFY_EMAIL=
RESEND_API_KEY=
MAIL_FROM=Auto ML <onboarding@resend.dev>

# Trainings that run at once = vCPUs of the container (standard-3 has 2). Others wait; beyond MAX_QUEUED_JOBS new runs are refused politely.
JOB_WORKERS=2
MAX_QUEUED_JOBS=30
DATASET_TTL_SECONDS=1800

GROQ_API_KEYS=
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
OPENROUTER_API_KEYS=

KAGGLE_API_TOKEN=
HF_TOKEN=
YOUTUBE_API_KEYS=
